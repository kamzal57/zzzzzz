# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.ts text
*.tsx text
*.js text
*.jsx text
*.json text
*.css text
*.html text
*.md text

# Configuration files
*.yml text
*.yaml text
*.toml text
*.config.* text

# Scripts
*.sh text eol=lf

# Documentation
*.md diff=markdown

# Exclude files from export
.gitattributes export-ignore
.gitignore export-ignore
.eslintrc.json export-ignore
